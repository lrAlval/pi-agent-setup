{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pi.uix.feedback/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "verdict",
    "build_ref",
    "annotations"
  ],
  "properties": {
    "version": {
      "const": "1"
    },
    "verdict": {
      "enum": [
        "approve",
        "request-changes"
      ]
    },
    "build_ref": {
      "type": "string",
      "minLength": 1
    },
    "annotations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/annotation"
      }
    }
  },
  "$defs": {
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target",
        "severity",
        "category",
        "comment",
        "suggested_fix",
        "screenshot_ref"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "target": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "kind",
                "value"
              ],
              "properties": {
                "kind": {
                  "const": "css"
                },
                "value": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "kind",
                "value"
              ],
              "properties": {
                "kind": {
                  "const": "xpath"
                },
                "value": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "kind",
                "value"
              ],
              "properties": {
                "kind": {
                  "const": "bbox"
                },
                "value": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "severity": {
          "enum": [
            "p0",
            "p1",
            "p2",
            "p3"
          ]
        },
        "category": {
          "enum": [
            "layout",
            "type",
            "color",
            "content",
            "a11y",
            "perf",
            "other"
          ]
        },
        "comment": {
          "type": "string"
        },
        "suggested_fix": {
          "type": "string"
        },
        "screenshot_ref": {
          "type": "string"
        }
      }
    }
  }
}
