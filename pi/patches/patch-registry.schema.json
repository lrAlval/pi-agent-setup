{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "local-patch-guard registry (v2)",
  "type": "object",
  "required": ["entries"],
  "properties": {
    "versions": {
      "type": "object",
      "properties": {
        "registry": { "type": "number" }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "package", "target", "steps"],
        "properties": {
          "name": { "type": "string" },
          "package": { "type": "string" },
          "pinnedVersion": { "type": "string" },
          "target": {
            "type": "object",
            "properties": {
              "file": { "type": "string" },
              "dirScan": { "type": "string" },
              "anchors": { "type": "array", "items": { "type": "string" } }
            }
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["script", "marker"],
              "properties": {
                "script": { "type": "string" },
                "marker": { "type": "string" }
              }
            }
          },
          "verify": {
            "oneOf": [
              { "$ref": "#/definitions/verifier" },
              { "type": "array", "items": { "$ref": "#/definitions/verifier" } }
            ]
          }
        }
      }
    }
  },
  "definitions": {
    "verifier": {
      "type": "object",
      "required": ["script", "passLine"],
      "properties": {
        "script": { "type": "string" },
        "passLine": { "type": "string" }
      }
    }
  }
}
