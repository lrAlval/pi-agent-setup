{
  "packages": [
    "packages/better-plan-mode",
    "npm:pi-rtk-optimizer",
    "npm:pi-subagents-lite",
    "custom-extensions/pi-todo-eta",
    "npm:@dietrichgebert/ponytail",
    "npm:pi-ast-grep",
    "npm:pi-smart-fetch@0.3.17",
    "npm:pi-caveman",
    "npm:pi-background-tasks",
    "npm:@zosmaai/pi-llm-wiki",
    "npm:@plannotator/pi-extension",
    "npm:pi-mcp-adapter",
    "npm:@vigolium/piolium",
    "npm:pi-hermes-memory",
    "npm:pi-observational-memory",
    "git:https://github.com/hasit/pi-community-themes",
    "npm:@henryqw/pi-codegraph",
    "npm:pi-hide-providers",
    "npm:@gotgenes/pi-permission-system",
    "npm:@henryqw/pi-undo",
    "npm:pi-footer",
    "npm:@underactive/pi-topping-statusline",
    "packages/pi-observability-plugin",

    "npm:@barlevalon/thermo-nuclear-code-quality-review-skill",
    "npm:pi-codemode-toggle",
    "npm:@nguyenquangthai/pi-omp-theme",
    "git:github.com/elpapi42/pi-fork",
    "npm:billion-context-pi"
  ],
  "skills": [
    "~/.agents/skills/xias-data-dashboard",
    "~/.agents/skills/xias-design-screen"
  ],
  "theme": "titanium",
  "piOmpTheme": {
    "preset": "omp",
    "tools": {
      "enabled": false
    },
    "theme": {
      "autoApply": "titanium"
    },
    "statusLine": {
      "enabled": false
    },
    "compatibility": {
      "allowCorePatches": true
    }
  },
  "hideThinkingBlock": true,
  "perModeModelSelection": true,
  "modeModels": {
    "plan": "opencode-go/glm-5.3-flash:medium",
    "build": "opencode-go/muse-spark-1.3-contributor:medium"
  },
  "modelThinkingLevels": {
    "opencode-go/mimo-v2.6-flash": "medium",
    "opencode-go/deepseek-v4.1-flash": "medium",
    "opencode-go/glm-5.3-flash": "medium",
    "opencode-go/muse-spark-1.3-contributor": "medium"
  },
  "llm-wiki": {
    "notices": false,
    "autoRecall": false,
    "customTypes": {
      "brainstorm": "brainstorms",
      "spike": "spikes",
      "implementation-plan": "plans",
      "decision": "decisions"
    }
  },
  "defaultProvider": "opencode-go",
  "defaultModel": "glm-5.3-flash",
  "lastChangelogVersion": "1.3.0",
  "extensions": [
    "-builtin:mcp"
  ],
  "defaultTools": [
    "read",
    "bash",
    "edit",
    "write",
    "+grep",
    "+find",
    "+ls",
    "+codemode"
  ],
  "codemode": {
    "mode": "on"
  },
  "pi-fork": {
    "defaultEffort": "balanced",
    "effortProfiles": {
      "fast": {
        "provider": "opencode-go",
        "id": "deepseek-v4.1-flash",
        "thinking": "minimal"
      },
      "balanced": {
        "provider": "opencode-go",
        "id": "muse-spark-1.3-contributor",
        "thinking": "low"
      },
      "deep": {
        "provider": "opencode-go",
        "id": "muse-spark-1.3-contributor",
        "thinking": "medium"
      }
    }
  }
}
