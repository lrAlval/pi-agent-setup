{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "permission": {
    "*": "allow",
    "bash": {
      "*": "allow",
      "chmod -R 777 *": "ask",
      "chmod -R a+w *": "ask",
      "dd *": "ask",
      "dd *of=/dev/*": "deny",
      "gh *": "allow",
      "gh api *DELETE*": "ask",
      "gh release delete *": "ask",
      "gh repo delete *": "ask",
      "gh issue delete *": "ask",
      "gh secret delete *": "ask",
      "gh variable delete *": "ask",
      "gh gpg-key delete *": "ask",
      "gh ssh-key delete *": "ask",
      "gh run delete *": "ask",
      "gh cache delete *": "ask",
      "gh gist delete *": "ask",
      "gh codespace delete *": "ask",
      "gh api *delete*": "ask",
      "git clean*": "ask",
      "git checkout --*": "ask",
      "halt*": "ask",
      "mkfs*": "deny",
      "poweroff*": "ask",
      "reboot*": "ask",
      "rm -fr *": "ask",
      "rm -rf *": "ask",
      "rtk *": "allow",
      "rtk chmod -R 777 *": "ask",
      "rtk chmod -R a+w *": "ask",
      "rtk dd *": "ask",
      "rtk dd *of=/dev/*": "deny",
      "rtk gh api *DELETE*": "ask",
      "rtk gh release delete *": "ask",
      "rtk gh repo delete *": "ask",
      "rtk gh issue delete *": "ask",
      "rtk gh secret delete *": "ask",
      "rtk gh variable delete *": "ask",
      "rtk gh gpg-key delete *": "ask",
      "rtk gh ssh-key delete *": "ask",
      "rtk gh run delete *": "ask",
      "rtk gh cache delete *": "ask",
      "rtk gh gist delete *": "ask",
      "rtk gh codespace delete *": "ask",
      "rtk gh api *delete*": "ask",
      "rtk git clean*": "ask",
      "rtk git checkout --*": "ask",
      "rtk mkfs*": "deny",
      "rtk rm -fr *": "ask",
      "rtk rm -rf *": "ask",
      "rtk sudo *": "ask",
      "shutdown*": "ask",
      "sudo *": "ask",
      "rm *": "ask",
      "rtk rm *": "ask",
      "chmod *": "ask",
      "rtk chmod *": "ask",
      "chown *": "ask",
      "rtk chown *": "ask",
      "kill *": "ask",
      "rtk kill *": "ask",
      "pkill *": "ask",
      "rtk pkill *": "ask",
      "killall *": "ask",
      "rtk killall *": "ask",
      "git push *--force*": "ask",
      "rtk git push *--force*": "ask",
      "git push *--delete*": "ask",
      "rtk git push *--delete*": "ask",
      "git reset --hard*": "ask",
      "rtk git reset --hard*": "ask",
      "git push * -f *": "ask",
      "git push * -f": "ask",
      "rtk git push * -f *": "ask",
      "rtk git push * -f": "ask"
    },
    "external_directory": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "/dev/*": "deny",
      "~/.ssh/*": "deny",
      "/dev/null": "allow"
    }
  },
  "permissionReviewLog": true,
  "yoloMode": false
}